# Copy to ~/.config/omarchy/llm.conf and adjust.
# Sourced by austraz.translate/llm/lib.sh

LEMONADE_HOST="${LEMONADE_HOST:-http://127.0.0.1:13305}"
# Optional npu-queue (austraz.translate/bin/npu-queue): point LEMONADE_HOST at
# http://127.0.0.1:13306 and set how long a job may wait for the NPU (seconds).
# 0 = no queue: talk to Lemonade directly, as before.
LLM_QUEUE_WAIT="${LLM_QUEUE_WAIT:-0}"
OLLAMA_HOST="${OLLAMA_HOST:-http://127.0.0.1:11434}"

# One NPU slot: same FLM for chat + vision so tools never evict each other.
# qwen3.5-4b-FLM is multimodal. Do not use qwen3-it-4b-FLM (FLM 1.0.4 SIGABRT).
LLM_TEXT_SMALL="${LLM_TEXT_SMALL:-qwen3.5-4b-FLM}"
LLM_TEXT_FULL="${LLM_TEXT_FULL:-qwen3.5-4b-FLM}"
LLM_VISION="${LLM_VISION:-qwen3.5-4b-FLM}"
OLLAMA_VISION="${OLLAMA_VISION:-qwen2.5vl:3b}"

VISION_KEEP_ALIVE="${VISION_KEEP_ALIVE:-300}"
